<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What Xcode writes for Signing & Capabilities > App Attest. `development` is right for runs from
  Xcode: the worker counts a development attestation as `registered`, not `attested`
  (docs/feedback-reports.md §8.1). Builds distributed through TestFlight or the App Store attest in
  production; an app that wants production from a local build sets the value to `production`.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>development</string>
</dict>
</plist>
